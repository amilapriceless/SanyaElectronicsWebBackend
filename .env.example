# Backend Server Configuration
PORT=5000

# MongoDB Connection String (MongoDB Atlas URI or local instance)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/dbname
# Use the MongoDB database user credentials, not your Atlas website login.
# URL-encode special characters in the password (for example, @ becomes %40).
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sanyaelectronics?retryWrites=true&w=majority

# Execution Environment (development | production)
NODE_ENV=development

# Allowed CORS Origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication secrets. Replace AUTH_JWT_SECRET with a random value before deployment.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_PRIMARY_PASSCODE=replace-with-a-strong-primary-passcode
AUTH_OFFICER_PASSWORD=replace-with-a-strong-officer-password
AUTH_SYSTEM_ADMIN_PASSWORD=replace-with-a-strong-system-admin-password
AUTH_SESSION_TTL=8h
